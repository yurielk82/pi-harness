#!/bin/zsh
set -euo pipefail

ROOT="${0:A:h:h}"
cd "$ROOT"

required_files=(
  ".pi/agents/teams.yaml"
  ".pi/agents/agent-chain.yaml"
  ".pi/damage-control-rules.yaml"
  ".pi/settings.json"
  ".pi/workflows/problem.md"
  ".pi/workflows/plan.md"
  ".pi/workflows/test-plan.md"
  ".pi/workflows/review-readiness.md"
  ".pi/workflows/release.md"
  ".pi/workflows/retro.md"
  ".agents/commands/prime.md"
  ".agents/commands/office-hours.md"
  ".agents/commands/plan-eng-review.md"
  ".agents/commands/review-readiness.md"
  ".agents/commands/ship.md"
  ".agents/commands/retro.md"
  ".agents/commands/learn.md"
  ".claude/commands/codex.md"
  ".codex/commands/codex.md"
  ".codex/commands/prime.md"
  ".codex/commands/office-hours.md"
  ".codex/commands/plan-eng-review.md"
  ".codex/commands/review-readiness.md"
  ".codex/commands/ship.md"
  ".codex/commands/retro.md"
  ".codex/commands/learn.md"
  "docs/intake-template.md"
  "docs/README.md"
)

echo "==> Typecheck"
bun x tsc --noEmit

echo "==> Settings JSON"
bun -e 'JSON.parse(require("node:fs").readFileSync(".pi/settings.json", "utf8"))'

echo "==> Required files"
for required_file in "${required_files[@]}"; do
  [[ -f "$required_file" ]] || {
    echo "missing required file: $required_file" >&2
    exit 1
  }
done

echo "==> Launcher scripts"
[[ -x "bin/pi-harness" ]] || {
  echo "pi-harness launcher is not executable" >&2
  exit 1
}
[[ -x "bin/codex-harness" ]] || {
  echo "codex-harness launcher is not executable" >&2
  exit 1
}
[[ -x "bin/smoke-test" ]] || {
  echo "smoke-test launcher is not executable" >&2
  exit 1
}

echo "==> pi-harness passthrough"
./bin/pi-harness typecheck >/dev/null

echo "==> Command mirrors"
for name in prime office-hours plan-eng-review review-readiness ship retro learn; do
  [[ "$(<".agents/commands/${name}.md")" == "$(<".codex/commands/${name}.md")" ]] || {
    echo "command definitions diverged: $name" >&2
    exit 1
  }
done

echo "==> Codex launcher"
./bin/codex-harness --help >/dev/null

echo "Smoke checks passed."
