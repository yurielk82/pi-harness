#!/bin/zsh
set -euo pipefail

ROOT="${0:A:h:h}"
cd "$ROOT"

CODEX_BIN="${commands[codex]-}"
if [[ -z "$CODEX_BIN" ]]; then
  for candidate in /opt/homebrew/bin/codex /usr/local/bin/codex; do
    if [[ -x "$candidate" ]]; then
      CODEX_BIN="$candidate"
      break
    fi
  done
fi

if [[ -z "$CODEX_BIN" ]]; then
  echo "codex not found on PATH" >&2
  exit 127
fi

exec "$CODEX_BIN" --cd "$ROOT" "$@"
